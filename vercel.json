{
  "version": 2,
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" }
  ],
  "functions": {
    "api/webhook.py": {
      "maxDuration": 60
    },
    "api/health.py": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.py" },
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}